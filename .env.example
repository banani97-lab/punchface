# Copy to .env.local. Everything is optional for local development.

# Public origin of the site. REQUIRED in production: sign-in and invite emails
# build their links from it.
APP_URL=http://localhost:3000

# Database. Defaults to a SQLite file at ./data/punchface.db.
# Point at a libSQL / Turso database to go hosted (no code changes).
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Where the SQLite file and uploaded images live. Defaults to ./data.
# PUNCHFACE_DATA_DIR=./data

# Email delivery through Resend (https://resend.com). Without a key, emails
# are recorded only and shown at /dev/outbox during development.
# RESEND_API_KEY=
# EMAIL_FROM="punchface <invites@yourdomain.com>"

# Invite writer. Without a key, "quick start" falls back to built-in templates.
# ANTHROPIC_API_KEY=

# Shared secret for POST /api/cron/reminders (automatic reminders and nudges).
# CRON_SECRET=

# Show /dev/outbox in a production build. It lists sign-in links: leave off.
# PUNCHFACE_DEV_OUTBOX=1
